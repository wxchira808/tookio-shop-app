{
  "expo": {
    "name": "Tookio Shop",
    "slug": "tookio-shop",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes Signature",
            "newArchEnabled": false
          }
        }
      ],
      "expo-asset"
    ],
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tookio.shop",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-2653266687589484~7788238441",
        "react-native-google-mobile-ads": {
          "android_app_id": "ca-app-pub-2653266687589484~7788238441"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "display": "standalone",
      "themeColor": "#242424",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "sitemap": false
      },
      "eas": {
        "projectId": "baeffd80-ea2c-4f67-aa93-6c5c50c08156"
      }
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "bundleIdentifier": "com.tookio.shop"
    }
  }
}
